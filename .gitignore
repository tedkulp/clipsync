# Rust
# Cargo.lock is intentionally NOT ignored: this workspace ships binaries,
# so the lockfile must be committed for reproducible builds.
/target
**/*.rs.bk

# Frontend (desktop/)
node_modules/
/desktop/dist
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tauri
# Regenerated by tauri-build on every compile; also platform-specific
# (macOS-schema.json vs linux-schema.json vs windows-schema.json).
/crates/desktop/gen/schemas/
# Mobile projects created by `cargo tauri android init` / `cargo tauri ios init`
/crates/desktop/gen/android/
/crates/desktop/gen/apple/

# Distributable bundles (built under /target; this catches stray copies)
*.dmg
*.deb
*.rpm
*.AppImage
*.msi
*.exe

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Env / local config
.env
.env.local
.env.*.local
.mise.local.toml
.claude/settings.local.json

# Arch Linux packaging (makepkg)
*.tar.zst
*.tar.gz
/src/
/pkg/

# Local tool output
/graphify-out/
